# Local Docker Compose development database.
POSTGRES_PASSWORD=local_dev_password_change_me
DATABASE_URL=postgresql+psycopg://nlti:local_dev_password_change_me@localhost:5432/nlti
NLTI_ENV=development
NLTI_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
NLTI_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_NLTI_API_URL=http://localhost:8000
NLTI_PUBLIC_APP_URL=http://localhost:3000
# Production email verification requires NLTI_SMTP_HOST and NLTI_SMTP_SENDER.
# Set NLTI_SMTP_USERNAME, NLTI_SMTP_PASSWORD, and NLTI_SMTP_PORT if required by the provider.
